<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/keyPressedBackgroundColor" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="?attr/keyboardKeyTextColor" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/functionalKeyBackground" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
