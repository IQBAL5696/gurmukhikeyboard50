<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ai_panel_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/ai_answer_back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_close"
            android:background="@android:color/transparent"
            android:contentDescription="Close" />

        <TextView
            android:id="@+id/ai_answer_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI Assistant"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/ai_answer_search_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_search"
            android:background="@android:color/transparent"
            android:contentDescription="Search AI" />

    </LinearLayout>

    <EditText
        android:id="@+id/ai_input_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ask AI..."
        android:textColor="#000000"
        android:textColorHint="#757575"
        android:layout_marginTop="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/ai_correct_word_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:src="@drawable/ic_check"
            android:background="@android:color/transparent"
            android:contentDescription="Correct Word" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/ai_continue_writing_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:src="@drawable/ic_continue_writing"
            android:background="@android:color/transparent"
            android:contentDescription="Continue Writing" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/ai_answer_copy_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:src="@drawable/ic_clipboard"
            android:background="@android:color/transparent"
            android:contentDescription="Copy" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/ai_answer_insert_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:src="@drawable/ic_return_arrow"
            android:background="@android:color/transparent"
            android:contentDescription="Insert" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:background="#11000000">

        <TextView
            android:id="@+id/ai_answer_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textIsSelectable="true" />

    </ScrollView>

</LinearLayout>
