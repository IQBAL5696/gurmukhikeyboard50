<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_button_bg"
    android:backgroundTint="#1E1E1E"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title and Live Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tv_filter_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Filter"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_filter_item_search"
            android:layout_width="150dp"
            android:layout_height="38dp"
            android:background="#2C2C2C"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="6dp"
            android:hint="Search"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:paddingHorizontal="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Sort A-Z / Z-A Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btn_filter_sort_asc"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#2C2C2C"
            android:text="A-Z  Ascending"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_filter_sort_desc"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#2C2C2C"
            android:text="Z-A  Descending"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Tab Header: Cell Value -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="Cell Value"
        android:textColor="#4CAF50"
        android:textSize="14sp"
        android:textStyle="bold" />

    <View
        android:layout_width="80dp"
        android:layout_height="2dp"
        android:background="#4CAF50" />

    <!-- Checklist Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:background="#282828"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/filter_checklist_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Bottom Action Bar: CLEAR / APPLY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_filter_clear"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#333333"
            android:text="CLEAR"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_filter_apply"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#2E7D32"
            android:text="APPLY"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
