<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3E0">

    <LinearLayout
        android:id="@+id/main_calendar_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_controls"
        android:orientation="vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="0dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:padding="6dp"
            android:background="@drawable/bg_calendar_main_header"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:elevation="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ਨਾਨਕਸ਼ਾਹੀ ਕੈਲੰਡਰ"
                android:textColor="#BF360C"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingLeft="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:paddingRight="2dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ਅੰਗਰੇਜ਼ੀ/ਦੇਸੀ"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#BF360C" />
                    <Switch
                        android:id="@+id/calendar_type_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleX="1"
                        android:scaleY="1"
                        android:thumbTint="#E65100"
                        android:trackTint="#80B3FF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ਵਿਧੀ:"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#BF360C" />
                    <Spinner
                        android:id="@+id/calendar_mode_spinner"
                        android:layout_width="100dp"
                        android:layout_height="20dp"
                        android:background="@android:color/transparent"
                        android:padding="0dp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/close_calendar_button"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:padding="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#BF360C"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>

        <!-- Information Card (Highlights) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFF8E1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/location_display_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="10sp"
                    android:textColor="#BF360C"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/monthly_highlights_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:layout_marginTop="1dp"
                    android:textColor="#D84315"
                    android:background="?attr/selectableItemBackground"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Navigation Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="1dp"
            android:background="@drawable/bg_calendar_nav_strip"
            android:elevation="1dp"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/prev_month_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#E65100" />
            <Spinner android:id="@+id/month_spinner_top" android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginHorizontal="2dp" />
            <Spinner android:id="@+id/year_spinner" android:layout_width="wrap_content" android:layout_height="28dp" />
            <ImageButton
                android:id="@+id/next_month_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_next"
                app:tint="#E65100" />
        </LinearLayout>

        <!-- Weekday Header Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFE0B2"
            android:orientation="horizontal"
            android:padding="0.5dp">

            <TextView
                style="@style/WeekDayText"
                android:text="ਐਤ"
                android:textSize="10sp" />

            <TextView
                style="@style/WeekDayText"
                android:text="ਸੋਮ"
                android:textSize="10sp" />

            <TextView
                style="@style/WeekDayText"
                android:text="ਮੰਗਲ"
                android:textSize="10sp" />

            <TextView
                style="@style/WeekDayText"
                android:text="ਬੁੱਧ"
                android:textSize="10sp" />

            <TextView
                style="@style/WeekDayText"
                android:text="ਵੀਰ"
                android:textSize="10sp" />

            <TextView
                style="@style/WeekDayText"
                android:text="ਸ਼ੁੱਕਰ"
                android:textSize="10sp" />

            <TextView
                style="@style/WeekDayText"
                android:text="ਸ਼ਨੀ"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Container for Recycler and Info Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/calendarRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.6"
                android:padding="0.5dp"
                android:background="#FFF8E1" />

            <!-- Promo Container for standalone apps -->
            <LinearLayout
                android:id="@+id/promo_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center" />

            <!-- Compressed Info Panel -->
            <androidx.cardview.widget.CardView
                android:id="@+id/info_panel_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.4"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp"
                android:visibility="gone"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFECB3">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/nanakshahi_calendar_output_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:textSize="11sp"
                        android:textColor="#3E2723"
                        android:lineSpacingExtra="1dp"
                        android:typeface="monospace" />
                </androidx.core.widget.NestedScrollView>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
            <Spinner android:id="@+id/spinnerDay" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Spinner android:id="@+id/spinnerMonth" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Spinner android:id="@+id/spinnerYear" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:elevation="8dp"
        android:padding="0.5dp"
        android:background="@drawable/bg_calendar_bottom_bar">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="0.5dp">
                <Button android:id="@+id/btn_today" android:layout_width="wrap_content" android:layout_height="42dp" android:backgroundTint="#EF6C00" android:text="ਅੱਜ" android:textSize="14sp" android:paddingHorizontal="16dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/btn_hukamnama" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="4dp" android:backgroundTint="#EF6C00" android:text="ਹੁਕਮਨਾਮਾ" android:textSize="14sp" android:paddingHorizontal="16dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/btn_events" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="4dp" android:backgroundTint="#EF6C00" android:text="ਗੁਰਪੁਰਬ" android:textSize="14sp" android:paddingHorizontal="16dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/findDateButton" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="4dp" android:backgroundTint="#EF6C00" android:text="ਖੋਜ" android:textSize="14sp" android:paddingHorizontal="16dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/calculateDateButton" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="4dp" android:backgroundTint="#EF6C00" android:text="ਅੰਤਰ" android:textSize="14sp" android:paddingHorizontal="16dp" android:insetTop="0dp" android:insetBottom="0dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/calendar_bottom_spacer_height"
            android:background="@android:color/transparent" />

    </LinearLayout>
</RelativeLayout>
