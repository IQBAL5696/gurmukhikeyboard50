<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ਗੁਰਮੁਖੀ ਕੀਬੋਰਡ"
            android:textColor="#E65100"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Best Gurmukhi Keyboard with Calendar"
            android:textColor="#757575"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Shortcut Section (Moved Above Setup) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/shortcutCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ਹੋਮ ਸਕ੍ਰੀਨ ਸ਼ਾਰਟਕੱਟ"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenCalculator"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="ਕੈਲਕੁਲੇਟਰ ਸ਼ਾਰਟਕੱਟ ਜੋੜੋ"
                    app:icon="@drawable/ic_calculator"
                    app:iconTint="#EF6C00"
                    app:strokeColor="#EF6C00"
                    android:textColor="#EF6C00" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddNitnemShortcut"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="10dp"
                    android:text="ਨਿਤਨੇਮ ਸ਼ਾਰਟਕੱਟ ਜੋੜੋ"
                    app:icon="@drawable/ik_onkar_svg"
                    app:iconTint="#4CAF50"
                    app:strokeColor="#4CAF50"
                    android:textColor="#4CAF50" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddCalendarShortcut"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="10dp"
                    android:text="ਜੰਤਰੀ ਸ਼ਾਰਟਕੱਟ ਜੋੜੋ"
                    app:icon="@drawable/ic_calender"
                    app:iconTint="#1976D2"
                    app:strokeColor="#1976D2"
                    android:textColor="#1976D2" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Setup Section (Moved Below Shortcuts) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/setupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FFE0B2"
            app:layout_constraintTop_toBottomOf="@id/shortcutCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ਕੀਬੋਰਡ ਸੈੱਟਅੱਪ (Keyboard Setup)"
                    android:textColor="#E65100"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnableKeyboard"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="1. ਕੀਬੋਰਡ ਇਨੇਬਲ ਕਰੋ"
                    android:textSize="16sp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#EF6C00"
                    app:icon="@drawable/ic_settings"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectKeyboard"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="12dp"
                    android:text="2. ਕੀਬੋਰਡ ਸਿਲੈਕਟ ਕਰੋ"
                    android:textSize="16sp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#EF6C00"
                    app:icon="@drawable/ic_language"
                    app:iconGravity="textStart" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Status: Loading..."
                    android:textAlignment="center"
                    android:textColor="#43A047"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Settings -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/setupCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ਤੁਰੰਤ ਸੈਟਿੰਗਜ਼ (Quick Settings)"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_vibrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ਵਾਈਬ੍ਰੇਸ਼ਨ (Vibrate)"
                    android:textSize="16sp"
                    android:paddingVertical="8dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_sound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ਆਵਾਜ਼ (Sound)"
                    android:textSize="16sp"
                    android:paddingVertical="8dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_popup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ਪੌਪ-ਅੱਪ (Popup)"
                    android:textSize="16sp"
                    android:paddingVertical="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Help Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/featuresCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/settingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ਕੀਬੋਰਡ ਫੰਕਸ਼ਨ ਗਾਈਡ"
                    android:textColor="#E65100"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:text="📅 ਨਾਨਕਸ਼ਾਹੀ ਕੈਲੰਡਰ: ਕੀਬੋਰਡ ਦੀ ਉੱਪਰਲੀ ਲਾਈਨ ਵਿੱਚ ਕੈਲੰਡਰ ਆਈਕਨ ਦਬਾਓ। ਇੱਥੇ ਤੁਸੀਂ ਸੂਰਜ ਚੜ੍ਹਨ/ਡੁੱਬਣ ਦਾ ਸਮਾਂ, ਸੰਗਰਾਂਦ, ਮੱਸਿਆ ਅਤੇ ਪੁੰਨਿਆ ਦੇਖ ਸਕਦੇ ਹੋ। ਕਿਸੇ ਗੁਰਪੁਰਬ ਵਾਲੀ ਤਾਰੀਖ 'ਤੇ ਕਲਿੱਕ ਕਰਨ 'ਤੇ ਉਸਦਾ ਇਤਿਹਾਸ ਦਿਖਾਈ ਦੇਵੇਗਾ।\n\n🔍 ਗੁਰਬਾਣੀ ਸਰਚ: ਗੂਗਲ ਜਾਂ ਕਿਸੇ ਵੀ ਐਪ ਵਿੱਚ ਅੱਖਰ ਲਿਖ ਕੇ ਸਰਚ ਆਈਕਨ ਦਬਾਓ, ਉਹ ਅੱਖਰ ਆਪਣੇ ਆਪ GurbaniNow ਵੈੱਬਸਾਈਟ 'ਤੇ ਸਰਚ ਹੋ ਜਾਣਗੇ।\n\n🛠️ ਸਮਾਰਟ ਟੂਲਬਾਰ: ਸੈਟਿੰਗਜ਼ ਵਿੱਚ 'Top Row Settings' ਰਾਹੀਂ ਤੁਸੀਂ ਆਪਣੀ ਪਸੰਦ ਦੇ ਬਟਨ (Emoji, Mic, Translate) ਉੱਪਰਲੀ ਲਾਈਨ ਵਿੱਚ ਰੱਖ ਸਕਦੇ ਹੋ।"
                    android:textSize="14sp"
                    android:textColor="#424242" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareApp"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="Share App"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_share"
            app:layout_constraintTop_toBottomOf="@id/featuresCard" />

        <Button
            android:id="@+id/btnPrivacyPolicy"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Privacy Policy"
            android:textColor="#757575"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/btnShareApp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
