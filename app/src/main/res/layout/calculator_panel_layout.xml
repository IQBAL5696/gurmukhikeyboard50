<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calculator_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Unified Header and Display Area -->
    <LinearLayout
        android:id="@+id/calculator_display_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#B2D3C2"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Integrated Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="0dp">

            <TextView
                android:id="@+id/calculator_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:text="ਕੈਲਕੁਲੇਟਰ"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/settings_calculator_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_toStartOf="@id/close_calculator_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:src="@drawable/ic_settings"
                app:tint="#333333" />

            <ImageButton
                android:id="@+id/close_calculator_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:padding="6dp"
                app:tint="#333333" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:id="@+id/calculator_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="00"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp" />

            <TextView
                android:id="@+id/calculator_formula"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_toEndOf="@id/calculator_steps"
                android:layout_toStartOf="@+id/memory_indicator"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text=""
                android:textColor="#555555"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:ellipsize="start" />

            <TextView
                android:id="@+id/memory_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text=""
                android:textColor="#333333"
                android:textSize="14sp"
                android:fontFamily="monospace" />
        </RelativeLayout>

        <HorizontalScrollView
            android:id="@+id/display_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">
            <TextView
                android:id="@+id/calculator_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:gravity="end"
                android:text="0"
                android:textColor="#222222"
                android:textSize="50sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:singleLine="true"
                android:ellipsize="none" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_recycler_view_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- Scientific Buttons Row (Hidden by default) -->
    <GridLayout
        android:id="@+id/scientific_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:padding="1dp"
        android:visibility="gone">
        <com.google.android.material.button.MaterialButton android:id="@+id/button_sqrt" style="@style/CalculatorButtonNumber" android:text="√" android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_square" style="@style/CalculatorButtonNumber" android:text="x²" android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_pi" style="@style/CalculatorButtonNumber" android:text="π" android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_e" style="@style/CalculatorButtonNumber" android:text="e" android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_power" style="@style/CalculatorButtonNumber" android:text="^" android:textSize="14sp" />
    </GridLayout>

    <GridLayout
        android:id="@+id/scientific_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:padding="1dp"
        android:visibility="gone">
        <com.google.android.material.button.MaterialButton android:id="@+id/button_sin" style="@style/CalculatorButtonNumber" android:text="sin" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_cos" style="@style/CalculatorButtonNumber" android:text="cos" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_tan" style="@style/CalculatorButtonNumber" android:text="tan" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_log" style="@style/CalculatorButtonNumber" android:text="log" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_ln" style="@style/CalculatorButtonNumber" android:text="ln" android:textSize="12sp" />
    </GridLayout>

    <!-- Buttons Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:padding="1dp"
        android:rowCount="6">

        <!-- Row 1 -->
        <com.google.android.material.button.MaterialButton android:id="@+id/button_gst_minus" style="@style/CalculatorButtonBlue" android:text="GST-" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_gst_18"
            style="@style/CalculatorButtonBlue"
            android:textSize="12sp"
            android:text="18%\nGST" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_gst_5"
            style="@style/CalculatorButtonBlue"
            android:textSize="12sp"
            android:text="5%\nGST" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_gst_12"
            style="@style/CalculatorButtonBlue"
            android:textSize="12sp"
            android:text="12%\nGST" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_clear"
            style="@style/CalculatorButtonGreen"
            android:text="AC" />

        <!-- Row 2 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_check"
            style="@style/CalculatorButtonNumber"
            android:textSize="11sp"
            android:text="CHECK\n▷" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_correct"
            style="@style/CalculatorButtonNumber"
            android:textSize="11sp"
            android:text="CORRECT\n⌫ 0-0" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_m_plus" style="@style/CalculatorButtonNumber" android:text="M+" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_m_minus" style="@style/CalculatorButtonNumber" android:text="M-" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_mrc" style="@style/CalculatorButtonNumber" android:text="MRC" />

        <!-- Row 3 -->
        <com.google.android.material.button.MaterialButton android:id="@+id/button_7" style="@style/CalculatorButtonDigit" android:text="7" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_8" style="@style/CalculatorButtonDigit" android:text="8" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_9" style="@style/CalculatorButtonDigit" android:text="9" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_divide" style="@style/CalculatorButtonNumber" android:text="÷" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_gt" style="@style/CalculatorButtonNumber" android:text="GT" />

        <!-- Row 4 -->
        <com.google.android.material.button.MaterialButton android:id="@+id/button_4" style="@style/CalculatorButtonDigit" android:text="4" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_5" style="@style/CalculatorButtonDigit" android:text="5" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_6" style="@style/CalculatorButtonDigit" android:text="6" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_multiply" style="@style/CalculatorButtonNumber" android:text="X" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_plus_minus" style="@style/CalculatorButtonNumber" android:text="+/-" />

        <!-- Row 5 -->
        <com.google.android.material.button.MaterialButton android:id="@+id/button_1" style="@style/CalculatorButtonDigit" android:text="1" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_2" style="@style/CalculatorButtonDigit" android:text="2" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_3" style="@style/CalculatorButtonDigit" android:text="3" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_add"
            style="@style/CalculatorButtonNumber"
            android:text="+" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_percent" style="@style/CalculatorButtonNumber" android:text="%" />

        <!-- Row 6 -->
        <com.google.android.material.button.MaterialButton android:id="@+id/button_0" style="@style/CalculatorButtonDigit" android:text="0" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_00" style="@style/CalculatorButtonDigit" android:text="00" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_dot" style="@style/CalculatorButtonDigit" android:text="." />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_subtract" style="@style/CalculatorButtonNumber" android:text="-" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_equals" style="@style/CalculatorButtonNumber" android:text="=" />

    </GridLayout>

</LinearLayout>
