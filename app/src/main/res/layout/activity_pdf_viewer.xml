<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pdf_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEEEEE">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/pdf_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="#3E2723"
        android:elevation="4dp"
        app:titleTextColor="@android:color/white">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_night_mode"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Night Mode"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_night_mode"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btn_search_page"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search Page"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btn_bookmark"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Bookmark Page"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bookmark"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btn_add_shortcut"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Add Shortcut to Home Screen"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shortcut"
                app:tint="@android:color/white" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- Search Bar Layout for Page Numbers & Text Search -->
    <LinearLayout
        android:id="@+id/pdf_search_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/pdf_toolbar"
        android:background="#3E2723"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_search_input"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_button_bg"
                android:backgroundTint="#FFFFFF"
                android:hint="ਪੰਨਾ ਨੰ. (1,2,3...) ਜਾਂ ਅੱਖਰ/ਸ਼ਬਦ ਸਰਚ ਕਰੋ..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="#000000"
                android:textColorHint="#757575"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_execute_search"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Execute Search"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btn_close_search"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Search"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@android:color/white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/pdf_search_results_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_search_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ਨਤੀਜਾ: 0 / 0"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_prev_search_match"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous Match"
                android:src="@drawable/ic_chevron_left"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btn_next_search_match"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next Match"
                android:src="@drawable/ic_chevron_right"
                app:tint="@android:color/white" />

        </LinearLayout>

    </LinearLayout>

    <com.iqbal.gurmukhikeyboard50.ZoomableRecyclerView
        android:id="@+id/pdf_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/pdf_search_bar_layout"
        android:background="#EEEEEE"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/pdf_controls_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_prev_page"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous Page"
                android:src="@drawable/ic_chevron_left"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/pdf_page_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/rounded_button_bg"
                android:backgroundTint="#80000000"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="ਪੰਨਾ: 1 / 1"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_next_page"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next Page"
                android:src="@drawable/ic_chevron_right"
                app:tint="@android:color/white" />

        </LinearLayout>

        <SeekBar
            android:id="@+id/pdf_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            android:maxHeight="4dp"
            android:progressTint="@android:color/white"
            android:thumbTint="#FFB300" />

    </LinearLayout>

</RelativeLayout>