<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calculator_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <!-- Unified Header and Display Area -->
    <LinearLayout
        android:id="@+id/calculator_display_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="#B2D3C2"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Integrated Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="2dp">

            <TextView
                android:id="@+id/calculator_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:text="CALCULATOR"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />


            <ImageButton
                android:id="@+id/steps_calculator_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_toStartOf="@id/library_calculator_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_check"
                app:tint="#333333" />

            <ImageButton
                android:id="@+id/library_calculator_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_toStartOf="@id/save_equation_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_library"
                app:tint="#333333" />

            <ImageButton
                android:id="@+id/save_equation_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_toStartOf="@id/graph_calculator_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_save"
                app:tint="#333333" />

            <ImageButton
                android:id="@+id/graph_calculator_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_toStartOf="@id/settings_calculator_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_play"
                app:tint="#333333" />

            <ImageButton
                android:id="@+id/settings_calculator_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                app:tint="#333333" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:id="@+id/calculator_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="00"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp" />

            <TextView
                android:id="@+id/calculator_formula"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_toEndOf="@id/calculator_steps"
                android:layout_toStartOf="@+id/memory_indicator"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text=""
                android:textColor="#555555"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:ellipsize="start" />

            <TextView
                android:id="@+id/memory_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text=""
                android:textColor="#333333"
                android:textSize="16sp"
                android:fontFamily="monospace" />
        </RelativeLayout>

        <EditText
            android:id="@+id/calculator_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@null"
            android:cursorVisible="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="end"
            android:inputType="textNoSuggestions|textVisiblePassword"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:singleLine="true"
            android:text="0"
            android:textColor="#222222"
            android:textCursorDrawable="@drawable/cursor_green"
            android:textSize="50sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_recycler_view_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/scientific_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="10"
        android:padding="1dp"
        android:visibility="gone">
        <Button android:id="@+id/button_parenthesis_open" style="@style/CalculatorButtonScientific" android:text="(" />
        <Button android:id="@+id/button_parenthesis_close" style="@style/CalculatorButtonScientific" android:text=")" />
        <Button android:id="@+id/button_pi" style="@style/CalculatorButtonScientific" android:text="π" />
        <Button android:id="@+id/button_e" style="@style/CalculatorButtonScientific" android:text="e" />
        <Button android:id="@+id/button_square" style="@style/CalculatorButtonScientific" android:text="x²" />
        <Button android:id="@+id/button_sqrt" style="@style/CalculatorButtonScientific" android:text="√" />
        <Button android:id="@+id/button_power" style="@style/CalculatorButtonScientific" android:text="^" />
        <Button android:id="@+id/button_pentagon" style="@style/CalculatorButtonScientific" android:text="Pnt" />
        <Button android:id="@+id/button_hexagon" style="@style/CalculatorButtonScientific" android:text="Hex" />
        <Button android:id="@+id/button_factorial" style="@style/CalculatorButtonScientific" android:text="x!" />
    </GridLayout>

    <GridLayout
        android:id="@+id/scientific_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="10"
        android:padding="1dp"
        android:visibility="gone">
        <Button android:id="@+id/button_2nd" style="@style/CalculatorButtonScientific" android:text="2nd" />
        <Button android:id="@+id/button_deg_rad" style="@style/CalculatorButtonScientific" android:text="DEG" />
        <Button android:id="@+id/button_sin" style="@style/CalculatorButtonScientific" android:text="sin" />
        <Button android:id="@+id/button_cos" style="@style/CalculatorButtonScientific" android:text="cos" />
        <Button android:id="@+id/button_tan" style="@style/CalculatorButtonScientific" android:text="tan" />
        <Button android:id="@+id/button_log" style="@style/CalculatorButtonScientific" android:text="log" />
        <Button android:id="@+id/button_ln" style="@style/CalculatorButtonScientific" android:text="ln" />
        <Button android:id="@+id/button_sinh" style="@style/CalculatorButtonScientific" android:text="sinh" />
        <Button android:id="@+id/button_cosh" style="@style/CalculatorButtonScientific" android:text="cosh" />
        <Button android:id="@+id/button_tanh" style="@style/CalculatorButtonScientific" android:text="tanh" />
    </GridLayout>

    <GridLayout
        android:id="@+id/scientific_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:padding="1dp"
        android:visibility="gone">
        <Button android:id="@+id/button_layout" style="@style/CalculatorButtonScientific" android:text="Layout" />
        <Button android:id="@+id/button_geometry" style="@style/CalculatorButtonScientific" android:text="GEO" />
        <Button android:id="@+id/button_save_scientific" style="@style/CalculatorButtonScientific" android:text="SAVE" />
        <Button android:id="@+id/button_comma" style="@style/CalculatorButtonScientific" android:text="," />
    </GridLayout>

    <GridLayout
        android:id="@+id/scientific_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="9"
        android:padding="1dp"
        android:visibility="gone">
        <Button android:id="@+id/button_x_var" style="@style/CalculatorButtonScientific" android:text="X" />
        <Button android:id="@+id/button_y_var" style="@style/CalculatorButtonScientific" android:text="Y" />
        <Button android:id="@+id/button_polynomial" style="@style/CalculatorButtonScientific" android:text="Poly" />
        <Button android:id="@+id/button_solve" style="@style/CalculatorButtonScientific" android:text="Solve" />
        <Button android:id="@+id/button_3d_mode" style="@style/CalculatorButtonScientific" android:text="3D" />
        <Button android:id="@+id/button_spiral" style="@style/CalculatorButtonScientific" android:text="Spr" />
        <Button android:id="@+id/button_nested" style="@style/CalculatorButtonScientific" android:text="Nst" />
        <Button android:id="@+id/button_animation" style="@style/CalculatorButtonScientific" android:text="Anim" />
        <Button android:id="@+id/button_ans" style="@style/CalculatorButtonScientific" android:text="Ans" />
    </GridLayout>

    <!-- Buttons Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:padding="1dp"
        android:rowCount="6">

        <!-- Row 1: GT, +/-, Check, Correct, AC -->
        <Button
            android:id="@+id/button_gt"
            style="@style/CalculatorButtonNumber"
            android:text="GT" />
        <Button
            android:id="@+id/button_plus_minus"
            style="@style/CalculatorButtonNumber"
            android:text="+/-" />
        <Button
            android:id="@+id/button_check"
            style="@style/CalculatorButtonNumber"
            android:textSize="10sp"
            android:text="CHECK" />
        <Button
            android:id="@+id/button_correct"
            style="@style/CalculatorButtonNumber"
            android:textSize="10sp"
            android:text="CORRECT" />
        <Button
            android:id="@+id/button_clear"
            style="@style/CalculatorButtonGreen"
            android:text="AC" />

        <!-- Row 2: GST-, 7, 8, 9, ÷ -->
        <Button
            android:id="@+id/button_gst_minus"
            style="@style/CalculatorButtonBlue"
            android:textSize="16sp"
            android:text="GST-" />
        <Button
            android:id="@+id/button_7"
            style="@style/CalculatorButtonDigit"
            android:text="7" />
        <Button
            android:id="@+id/button_8"
            style="@style/CalculatorButtonDigit"
            android:text="8" />
        <Button
            android:id="@+id/button_9"
            style="@style/CalculatorButtonDigit"
            android:text="9" />
        <Button
            android:id="@+id/button_divide"
            style="@style/CalculatorButtonNumber"
            android:text="÷" />

        <!-- Row 3: 18%, 4, 5, 6, X -->
        <Button
            android:id="@+id/button_gst_18"
            style="@style/CalculatorButtonBlue"
            android:textSize="16sp"
            android:text="18% " />
        <Button
            android:id="@+id/button_4"
            style="@style/CalculatorButtonDigit"
            android:text="4" />
        <Button
            android:id="@+id/button_5"
            style="@style/CalculatorButtonDigit"
            android:text="5" />
        <Button
            android:id="@+id/button_6"
            style="@style/CalculatorButtonDigit"
            android:text="6" />
        <Button
            android:id="@+id/button_multiply"
            style="@style/CalculatorButtonNumber"
            android:text="X" />

        <!-- Row 4: 5%, 1, 2, 3, - -->
        <Button
            android:id="@+id/button_gst_5"
            style="@style/CalculatorButtonBlue"
            android:textSize="16sp"
            android:text="5% " />
        <Button
            android:id="@+id/button_1"
            style="@style/CalculatorButtonDigit"
            android:text="1" />
        <Button
            android:id="@+id/button_2"
            style="@style/CalculatorButtonDigit"
            android:text="2" />
        <Button
            android:id="@+id/button_3"
            style="@style/CalculatorButtonDigit"
            android:text="3" />
        <Button
            android:id="@+id/button_subtract"
            style="@style/CalculatorButtonNumber"
            android:text="-" />

        <!-- Row 5: 12%, 0, 00, ., + -->
        <Button
            android:id="@+id/button_gst_12"
            style="@style/CalculatorButtonBlue"
            android:textSize="16sp"
            android:text="12% " />
        <Button
            android:id="@+id/button_0"
            style="@style/CalculatorButtonDigit"
            android:text="0" />
        <Button
            android:id="@+id/button_00"
            style="@style/CalculatorButtonDigit"
            android:text="00" />
        <Button
            android:id="@+id/button_dot"
            style="@style/CalculatorButtonDigit"
            android:text="." />
        <Button
            android:id="@+id/button_add"
            style="@style/CalculatorButtonNumber"
            android:text="+" />

        <!-- Row 6: M+, M-, MRC, %, = -->
        <Button
            android:id="@+id/button_m_plus"
            style="@style/CalculatorButtonNumber"
            android:text="M+" />
        <Button
            android:id="@+id/button_m_minus"
            style="@style/CalculatorButtonNumber"
            android:text="M-" />
        <Button
            android:id="@+id/button_mrc"
            style="@style/CalculatorButtonNumber"
            android:text="MRC" />
        <Button
            android:id="@+id/button_percent"
            style="@style/CalculatorButtonNumber"
            android:text="%" />
        <Button
            android:id="@+id/button_equals"
            style="@style/CalculatorButtonNumber"
            android:text="=" />

    </GridLayout>

</LinearLayout>
